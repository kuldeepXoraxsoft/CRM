<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Welcome to <%= brandName %></title>
</head>
<body style="margin:0;padding:0;background-color:#ffffff;font-family:Arial,Helvetica,sans-serif;color:#222222;">

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#ffffff;">
    <tr>
      <td align="center" style="padding:24px 12px;">

        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;">

          <!-- Header -->
          <tr>
            <td style="padding:0 0 20px;border-bottom:1px solid #dddddd;">
              <% if (logoUrl) { %>
                <img
                  src="<%= logoUrl %>"
                  alt="<%= brandName %>"
                  style="display:block;max-width:150px;max-height:48px;width:auto;height:auto;border:0;"
                />
              <% } else { %>
                <p style="margin:0;font-size:18px;font-weight:bold;color:#222222;">
                  <%= brandName %>
                </p>
              <% } %>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding:24px 0;">

              <h1 style="margin:0 0 16px;font-size:20px;line-height:1.4;font-weight:bold;color:#222222;">
                Welcome to <%= brandName %>
              </h1>

              <p style="margin:0 0 16px;font-size:14px;line-height:1.7;color:#333333;">
                Hi <%= name || "there" %>,
              </p>

              <p style="margin:0 0 16px;font-size:14px;line-height:1.7;color:#333333;">
                Your account has been created. You can sign in using the details below.
              </p>

              <p style="margin:0 0 4px;font-size:14px;line-height:1.7;color:#333333;">
                <strong>Email:</strong> <%= email %>
              </p>

              <p style="margin:0 0 20px;font-size:14px;line-height:1.7;color:#333333;">
                <strong>Temporary password:</strong> <%= temporaryPassword %>
              </p>

              <p style="margin:0 0 20px;font-size:14px;line-height:1.7;color:#333333;">
                For security, please change your password after signing in for the first time.
                Do not share your password with anyone.
              </p>

              <p style="margin:0 0 20px;">
                <a href="<%= loginUrl %>" target="_blank"
                  style="display:inline-block;padding:10px 20px;background-color:#222222;color:#ffffff;text-decoration:none;font-size:14px;">
                  Sign in
                </a>
              </p>

              <p style="margin:0 0 6px;font-size:13px;line-height:1.6;color:#666666;">
                If the button doesn't work, copy and paste this link into your browser:
              </p>

              <p style="margin:0 0 20px;font-size:13px;line-height:1.6;word-break:break-all;">
                <a href="<%= loginUrl %>" style="color:#222222;text-decoration:underline;"><%= loginUrl %></a>
              </p>

              <p style="margin:0 0 16px;font-size:14px;line-height:1.7;color:#333333;">
                If you have any trouble accessing your account, please contact your administrator.
              </p>

              <p style="margin:0;font-size:14px;line-height:1.7;color:#333333;">
                Regards,<br />
                <%= brandName %> Team
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding:16px 0 0;border-top:1px solid #dddddd;">
              <p style="margin:0;font-size:12px;line-height:1.6;color:#777777;">
                This is an automated email. Please do not reply to this message.<br />
                &copy; <%= year %> <%= brandName %>. All rights reserved.
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>